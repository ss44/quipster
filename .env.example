MEILI_MASTER_KEY=replace-with-a-long-random-string
MEDIA_DIR=/mnt/plex-library
CACHE_DIR=/srv/quipster/cache

# Lightweight previews; fast downloads copy the original streams unchanged.
CLIP_PREVIEW_RES=640:-2
# Optional precise downloads only. -2 preserves the source aspect ratio.
CLIP_ACCURATE_RES=1280:-2
# Blank keeps preview=ultrafast and precise=veryfast; set ultrafast to favor speed.
CLIP_CPU_PRESET=
# Each embedded subtitle extraction scans the whole media file over the share.
# Try 1 on slow Samba storage to leave bandwidth for interactive previews.
EXTRACT_CONNS=1

# --- Semantic (vector) search, optional ---
# Meilisearch generates subtitle embeddings during document ingestion when an
# embedder is configured. Sources: openAi (any OpenAI-compatible endpoint via
# EMBEDDINGS_URL), huggingFace (free, downloads a local model on first use)
# or rest (any HTTP embedding service).
# EMBEDDINGS_SOURCE=openAi
# EMBEDDINGS_API_KEY=replace-with-embedding-api-key
# EMBEDDINGS_URL=                  # optional for openAi (Ollama, LM Studio, vLLM), required for rest
# EMBEDDINGS_MODEL=                # optional; provider default applies when blank
# EMBEDDINGS_DIMENSIONS=           # optional for openAi, required for rest
# EMBEDDINGS_DOCUMENT_TEMPLATE=    # defaults to {{doc.text}} (dialogue only)
# EMBEDDINGS_REQUEST=              # rest only: JSON request template
# EMBEDDINGS_RESPONSE=             # rest only: JSON response template
# EMBEDDINGS_SEMANTIC_RATIO=0.5    # hybrid keyword/semantic blend, 0..1
