MEILI_MASTER_KEY=replace-with-a-long-random-string
MEDIA_DIR=/mnt/plex-library
CACHE_DIR=/srv/quipster/cache

# Lightweight previews; fast downloads copy the original streams unchanged.
CLIP_PREVIEW_RES=640:-2
# Optional precise downloads only. -2 preserves the source aspect ratio.
CLIP_ACCURATE_RES=1280:-2
# Blank keeps preview=ultrafast and precise=veryfast; set ultrafast to favor speed.
CLIP_CPU_PRESET=
# Each embedded subtitle extraction scans the whole media file over the share.
# Try 1 on slow Samba storage to leave bandwidth for interactive previews.
EXTRACT_CONNS=1
